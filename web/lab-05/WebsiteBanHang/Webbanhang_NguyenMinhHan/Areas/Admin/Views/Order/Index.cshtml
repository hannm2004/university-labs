@model IEnumerable<Webbanhang_NguyenMinhHan.Models.Order>

<h2>Danh sách đơn hàng</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @(item.TotalPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a> 
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>