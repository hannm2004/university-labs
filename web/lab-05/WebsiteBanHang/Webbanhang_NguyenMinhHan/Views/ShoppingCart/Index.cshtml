@model ShoppingCart

<h2 class="mb-4">🛒 Giỏ hàng của bạn</h2>

<table class="table table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Giá</th>
            <th>Thành tiền</th>
            <th>Hành động</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <!-- Tên -->
                <td>@item.Name</td>

                <!-- Số lượng -->
                <td>
                    <form asp-controller="ShoppingCart"
                          asp-action="UpdateQuantity"
                          method="post"
                          class="d-flex justify-content-center">

                        <input type="hidden" name="productId" value="@item.ProductId" />

                        <input type="number"
                               name="quantity"
                               value="@item.Quantity"
                               min="1"
                               class="form-control w-50 me-2" />

                        <button class="btn btn-primary btn-sm" type="submit">
                            Cập nhật
                        </button>
                    </form>
                </td>

                <!-- Giá -->
                <td>
                    @item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ
                </td>

                <!-- Thành tiền -->
                <td>
                    @((item.Price * item.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ")
                </td>

                <td>
                    <a asp-action="RemoveFromCart"
                       asp-route-productId="@item.ProductId"
                       class="btn btn-danger btn-sm">

                        <i class="bi-trash"></i> Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="text-end mb-3">
    <h4>
        Tổng tiền:
        <span class="text-danger">
            @(Model.Items.Sum(i => i.Price * i.Quantity)
                .ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ")
        </span>
    </h4>
</div>

<div class="d-flex justify-content-between">

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-outline-primary">

        ← Tiếp tục mua hàng
    </a>

    <a asp-action="Checkout"
       class="btn btn-success">

        Thanh toán →
    </a>

</div>