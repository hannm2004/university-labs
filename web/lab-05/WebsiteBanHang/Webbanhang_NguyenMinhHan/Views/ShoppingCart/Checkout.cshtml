@model Order

<div class="container mt-4">
    <h2 class="mb-4 text-center">🧾 Thanh toán</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <form asp-action="Checkout" method="post" class="card shadow p-4">

                <!-- Địa chỉ -->
                <div class="mb-3">
                    <label asp-for="ShippingAddress" class="form-label">
                        Địa chỉ giao hàng
                    </label>
                    <input asp-for="ShippingAddress" class="form-control" placeholder="Nhập địa chỉ..." />
                </div>

                <!-- Ghi chú -->
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">
                        Ghi chú
                    </label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm..."></textarea>
                </div>

                <!-- Button -->
                <div class="d-flex justify-content-between mt-3">

                    <!-- Quay lại giỏ hàng -->
                    <a asp-controller="ShoppingCart"
                       asp-action="Index"
                       class="btn btn-secondary">
                        ← Quay lại giỏ hàng
                    </a>

                    <!-- Đặt hàng -->
                    <button type="submit" class="btn btn-success">
                        ✔ Đặt hàng
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>